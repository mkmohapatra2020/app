# Resource or Foundry project endpoint — either works.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_OPENAI_API_KEY=<your-key>
AZURE_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst

# Weekend-Live API (Azure API Management gateway). Server-side only.
# Paths from the swagger (/api/...) are appended after /service.
WL_API_URL=https://appi-wl.azure-api.net/service/api
# APIM subscription key — leave empty if the API product does not require one.
WL_API_KEY=

# --- .env.development (local dev only) ---
# Browser calls APIM directly; requires an APIM CORS policy allowing your localhost origin.
# VITE_BACKEND_URL=https://appi-wl.azure-api.net/service/api
# VITE_WL_API_KEY=<your APIM subscription key>

# Mock API for endpoints not deployed yet (see MOCK-APIS.md): planned (default) | off
# VITE_MOCK_API=off

# Real Estate sample data instead of the live /realestate API (local demos only): on | (unset)
# VITE_REALESTATE_MOCK=on

# Hybrid-encrypted /images/generate body: off (default) | on
# VITE_IMAGE_ENCRYPTION=off
