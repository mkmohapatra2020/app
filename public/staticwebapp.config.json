{
  "platform": { "apiRuntime": "node:20" },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "*.{js,css,png,jpg,jpeg,gif,webp,avif,svg,ico,json,woff,woff2,webmanifest,txt,xml}"]
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/images/*", "headers": { "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400" } },
    { "route": "/index.html", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": { ".webmanifest": "application/manifest+json", ".avif": "image/avif" }
}
